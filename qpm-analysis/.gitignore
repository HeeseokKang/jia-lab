# Large per-condition outputs — regenerated by src/dpc_analyze.py.
# Keep the aggregated master table in git, but skip the heavy arrays/figures.
analysis/**/*.npy
analysis/**/dpc_overview.png

# Heavy generated outputs (added 2026-05-18, see CLAUDE.md "Outputs policy").
# Canonical location for these artifacts is
# /data/Project_Data/QPM/<dataset>/outputs/. Existing items already on disk
# under analysis/ stay where they are until stage-by-stage migration; these
# rules only prevent future heavy outputs from entering git.
analysis/**/*.npz
analysis/*.html
analysis/figures/
analysis/tables/cells_*.csv

# Python cruft
__pycache__/
*.pyc
